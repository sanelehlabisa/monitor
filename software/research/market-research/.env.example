# Independent research config: copy to .env here, not to software/.env.
# Local Mailpit/SMS mocks do not use production credentials.
RESEARCH_EMAIL_FROM=research@example.com
RESEARCH_DKIM_SELECTOR=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Future Android interface only; these do not enable a real SMS adapter.
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_API_KEY=
