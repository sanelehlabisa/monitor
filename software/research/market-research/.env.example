# Independent research config. Never overwrite software/.env.
# Mock data only by default; for real SMTP select data/contacts.csv as well.
CONTACTS_CSV=data/local-test/task108/contacts.csv
RESEARCH_EMAIL_FROM=research@example.invalid
RESEARCH_DKIM_SELECTOR=

# Mailpit. For real SMTP use your provider host/port and own credentials.
# true = implicit TLS; false = required STARTTLS for non-loopback hosts.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Local SMS mock only; live Android adapter is not implemented.
SMS_GATEWAY_URL=http://127.0.0.1:8086/messages
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_API_KEY=
