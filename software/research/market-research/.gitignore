# Private inputs and generated files are excluded by default, including new names.
/*
!/.gitignore
!/README.md
!/.env.example

# Reviewed source allowlist. All inputs and generated files remain private.
!/pipeline.py
!/requirements.txt
!/send_due_messages.py

# Reviewed fixed-message templates only; other generated files stay private.
!/templates/
/templates/*
!/templates/email.txt
!/templates/sms.txt
