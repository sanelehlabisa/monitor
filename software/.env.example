# Development-only values. Copy this file to software/.env and change passwords.
POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev_only
POSTGRES_PORT=5432

BACKEND_PORT=8000
MONITOR_ENVIRONMENT=development
MONITOR_LOG_LEVEL=INFO
MONITOR_OTP_HMAC_SECRET=monitor_dev_otp_secret_change_me
# Blank disables automatic monthly mail. Set an aware UTC cutoff once; keep it on restarts.
MONITOR_MONTHLY_REMINDERS_ACTIVATED_AT=
FRONTEND_PORT=5173

# SMTP: false uses STARTTLS when available; true uses implicit TLS
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@monitor.local
