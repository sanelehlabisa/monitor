# Copy once to software/.env ONLY if it does not exist; never overwrite an installation.
# Production values: replace database/OTP secrets and supply real SMTP credentials.
# Dev Compose fixes local URLs, ports and Mailpit; no settings defaults in code.
# Browser origin served by the shared Roventics Nginx/Certbot proxy.
APP_BASE_URL=https://monitor.roventics.com

POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev_only
MONITOR_OTP_HMAC_SECRET=monitor_dev_otp_secret_change_me
# Blank disables automatic monthly mail. Set an aware UTC cutoff once; keep it on restarts.
MONITOR_MONTHLY_REMINDERS_ACTIVATED_AT=

# Production SMTP only; development always uses its internal Mailpit.
# SMTP: false uses STARTTLS when available; true uses implicit TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@monitor.roventics.com
