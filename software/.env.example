# Copy once to software/.env ONLY if it does not exist; never overwrite an installation.
# Values below are LOCAL examples. Before VPS use, replace the database password,
# OTP secret and SMTP values as described in production/README.md.
# Production-only public hostname: no protocol, path or port.
APP_DOMAIN=monitor.roventics.com

POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev_only
# These local ports/mode are unused by production Compose (no published app/DB ports).
POSTGRES_PORT=5432

BACKEND_PORT=8000
MONITOR_ENVIRONMENT=development
MONITOR_LOG_LEVEL=INFO
MONITOR_OTP_HMAC_SECRET=monitor_dev_otp_secret_change_me
# Blank disables automatic monthly mail. Set an aware UTC cutoff once; keep it on restarts.
MONITOR_MONTHLY_REMINDERS_ACTIVATED_AT=
FRONTEND_PORT=5173

# Local Mailpit below; VPS needs real provider host/port/credentials/sender.
# SMTP: false uses STARTTLS when available; true uses implicit TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@monitor.local
