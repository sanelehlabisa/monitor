# Optional Monitor API overrides. Do not commit a real .env file.
MONITOR_ENVIRONMENT=development
MONITOR_LOG_LEVEL=INFO
MONITOR_DATABASE_URL=postgresql://monitor:monitor_dev_only@database:5432/monitor
MONITOR_KEYCLOAK_ISSUER=http://localhost:8080/realms/monitor
MONITOR_KEYCLOAK_AUDIENCE=monitor-api
MONITOR_KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/monitor/protocol/openid-connect/certs
